# Canteen AI - Environment Configuration Template
# Copy this file to .env and fill in with your actual values
# IMPORTANT: Never commit .env file with real credentials to Git

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://postgres:mypassword@localhost:5432/canteen_ai
DATABASE_URL=postgresql://user:password@localhost:5432/canteen_ai

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Secret key for JWT token signing - must be a strong random string in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# JWT algorithm for token encoding
ALGORITHM=HS256

# JWT access token expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (set to false in production)
DEBUG=false

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# AI/VISION SERVICE CONFIGURATION (Future)
# =============================================================================
# Vision API provider (e.g., "azure", "google")
# VISION_API_PROVIDER=azure

# Vision API key (set when AI features are implemented)
# VISION_API_KEY=your-api-key

# Vision API endpoint
# VISION_API_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com

# =============================================================================
# LOGGING CONFIGURATION (Future)
# =============================================================================
# LOG_LEVEL=INFO
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# EMAIL CONFIGURATION (Future)
# =============================================================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@canteen-ai.local
